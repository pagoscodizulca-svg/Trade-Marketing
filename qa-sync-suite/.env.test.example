# ==============================================================================
# QA SYNC & SECURITY SUITE — PLANTILLA DE VARIABLES DE ENTORNO (.env.test)
# Copia este archivo a `qa-sync-suite/.env.test` y completa los valores reales.
# NUNCA subas `.env.test` al control de versiones ni imprimas sus valores.
# ==============================================================================

# URL base del proyecto de Supabase (ej: https://tu-proyecto.supabase.co)
SUPABASE_URL=https://example-project-ref.supabase.co

# Llave pública (publishable o anon) — usada por TODAS las pruebas funcionales autenticadas (TC-01 a TC-06)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_or_anon_placeholder_do_not_commit
SUPABASE_ANON_KEY=sb_publishable_or_anon_placeholder_do_not_commit

# Llave administrativa Service Role — usada EXCLUSIVAMENTE en:
#   - scripts/seed-qa-environment.mjs
#   - scripts/teardown-qa-environment.mjs
#   - scripts/verify-zero-residue.mjs
SUPABASE_SERVICE_ROLE_KEY=sb_secret_or_service_role_placeholder_do_not_commit

# URL desplegada en Render para health-check con backoff (hasta 60s) e HITO 4
RENDER_PLANIFICADOR_URL=https://dashboard-fdv-planificador.onrender.com

# URL de la interfaz de Trade Marketing / Módulo de Degustaciones y /portal
TRADE_MARKETING_APP_URL=http://localhost:3000

# Límite máximo de peticiones por segundo durante la suite (1 o 2)
QA_RATE_LIMIT_RPS=1

{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "start": "cross-env NODE_ENV=production node dist-server/server.js",
    "build": "npm --prefix ruta-degustacion ci --include=dev --no-audit --no-fund && npm run build:all",
    "build:web": "vite build",
    "build:logistica": "npm --prefix ruta-degustacion run build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --packages=external --target=node22 --outfile=dist-server/server.js",
    "build:all": "npm run build:web && npm run build:logistica && npm run build:server",
    "test": "node --import tsx --import ./tests/antigravity_audit/networkEgressGuard.mjs --test \"tests/**/*.test.ts\" \"tests/**/*.test.tsx\"",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "preview": "vite preview",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "diagnose:fdv-sync": "tsx scripts/diagnoseFdvTradeSync.ts",
    "verify:fase1": "tsx scripts/verifyFase1Schema.ts",
    "verify:fase2": "tsx scripts/verifyFase2Parsers.ts",
    "verify:modal-carga": "tsx scripts/verifyCalibracionModalCarga.ts",
    "verify:excel-dates": "tsx scripts/verifyExcelDateNormalizer.ts",
    "verify:excel-parser": "tsx scripts/verifyExcelDateParser.ts",
    "verify:carga-multiformato": "tsx scripts/verifyRefactorCargaMultiformato.ts",
    "verify:fdv-restore": "tsx scripts/verifyFdvDegustacionesRestoration.ts",
    "verify:zero-trust-ruta": "tsx scripts/verifyZeroTrustRutaSync.ts",
    "verify:metric-360": "tsx scripts/verifyMetric360Integrity.ts",
    "corte:historial": "tsx scripts/migrateCorteInicialHistorial.ts",
    "verify:historial-fase1": "tsx scripts/verifyHistorialDegustacionesFase1.ts",
    "verify:cierre-dominical": "tsx scripts/verifyFase2CierreDominicalCron.ts",
    "verify:asistencia-evidencias": "tsx scripts/verifyAsistenciaEvidenciasCondicional.ts",
    "verify:ciclo-semanal": "tsx scripts/verifyCicloSemanalDegustaciones.ts",
    "verify:pdf-autorizacion": "tsx scripts/verifyPendingAuthorizationPdf.ts",
    "verify:maestros": "tsx scripts/verifyMasterDataSync.ts",
    "auth:provision": "tsx scripts/provisionSupabaseAuthStaff.ts",
    "seed:promotoras": "tsx scripts/seed-promotoras.ts"
  },
  "dependencies": {
    "@google/genai": "3.1.0",
    "@supabase/supabase-js": "^2.119.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "cors": "^2.8.6",
    "docx": "^9.15.4",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "helmet": "^8.3.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "read-excel-file": "^9.3.17",
    "vite": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cross-env": "^7.0.3",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}

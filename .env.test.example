# Plantilla de credenciales locales para QA E2E (copiar a .env.test.local — ignorado por Git).
# PROHIBIDO commitear contraseñas reales, tokens ni SUPABASE_SERVICE_ROLE_KEY.

QA_BASE_URL=http://localhost:3000

# Cuenta Admin / Coordinación (Sistema Principal)
QA_ADMIN_EMAIL=
QA_ADMIN_PASSWORD=

# Cuenta Promotora (App de Promotoras /portal)
QA_PROMOTORA_EMAIL=
QA_PROMOTORA_PASSWORD=

# Cuenta Chofer (App de Chofer /logistica/)
QA_CHOFER_EMAIL=
QA_CHOFER_PASSWORD=

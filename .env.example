# PORT: Puerto del servidor Express/Vite (por defecto 3000)
PORT=3000

# ==============================================================================
# SUPABASE CLIENTE PÚBLICO — PROYECTO "Trade Marketing"
# SEGURIDAD CRÍTICA:
#   1. Usa la URL raíz del proyecto SIN sufijo "/rest/v1/".
#   2. En VITE_SUPABASE_PUBLISHABLE_KEY usa ÚNICAMENTE la Publishable Key (sb_publishable_...),
#      gobernada estrictamente por Row Level Security (RLS).
#   3. PROHIBIDO colocar llaves Secret / Service Role (sb_secret_... o service_role)
#      en variables con prefijo VITE_.
#   4. Copia este archivo como `.env.local` (ignorado por Git) y pega allí tu llave real.
# ==============================================================================
VITE_SUPABASE_URL=https://apaxdgxtaoeyswlfblgi.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=PEGA_AQUI_TU_SB_PUBLISHABLE_KEY

# COMPATIBILIDAD LEGADA (opcional): módulos previos aún aceptan VITE_SUPABASE_ANON_KEY.
# Si defines VITE_SUPABASE_PUBLISHABLE_KEY, tiene prioridad sobre esta variable.
VITE_SUPABASE_ANON_KEY=

# OPCIONAL — CLIENTE DEDICADO PARA DATA MAESTRA (Vendedores / Clientes)
# Si se omiten, masterDataSyncService reutiliza automáticamente VITE_SUPABASE_URL
# y VITE_SUPABASE_ANON_KEY. Útil durante migraciones graduales entre proyectos.
VITE_SUPABASE_MASTER_URL=
VITE_SUPABASE_MASTER_ANON_KEY=

# ==============================================================================
# SUPABASE BACKEND ADMINISTRATIVO (SOLO SERVIDOR - NUNCA USAR PREFIJO VITE_)
# Requerido únicamente en servidor Node/Express y scripts locales de aprovisionamiento
# ==============================================================================
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Clave universal para aprovisionar las 33 promotoras en Supabase Auth (`npm run seed:promotoras`).
# Pasar SOLO por entorno local/servidor seguro; NUNCA guardar valores literales en código ni Git.
PROMOTORA_UNIVERSAL_PASSWORD=

# Clave inicial para aprovisionar a Grecia (Coordinadora de Trade Occidente — `grecia01@codizulca.com`)
# mediante `npm run seed:coordinadora-occidente`. Pasar SOLO vía variable de entorno; NUNCA en Git.
GRECIA_INITIAL_PASSWORD=

# Clave inicial y nombre opcional para aprovisionar a María (Coordinadora de Trade Centro y Andes — `maria01@codizulca.com`)
# mediante `npm run seed:coordinadora-centro-andes`. Pasar SOLO vía variable de entorno; NUNCA en Git.
MARIA_INITIAL_PASSWORD=
MARIA_DISPLAY_NAME=

# CUENTA INICIAL COORDINADORA / ADMIN PARA SCRIPT `npm run auth:provision` (SOLO SERVIDOR, OPCIONAL)
INITIAL_COORDINATOR_EMAIL=
INITIAL_COORDINATOR_PASSWORD=

# EXTRACCIÓN ESTRUCTURADA DE ARCHIVOS PDF EN BACKEND (SOLO SERVIDOR - NUNCA USAR PREFIJO VITE_)
GEMINI_API_KEY=
OPENAI_API_KEY=
# Timeout máximo en milisegundos para llamadas externas de extracción PDF con Gemini/OpenAI (default: 45000)
AI_EXTRACTOR_TIMEOUT_MS=45000

# TIMEOUTS DE RESILIENCIA EXTERNA Y APAGADO ORDENADO
# Timeout máximo en ms para consulta externa de tasa oficial BCV (default: 10000)
BCV_FETCH_TIMEOUT_MS=10000
# Timeout máximo en ms antes de salida forzada durante graceful shutdown del servidor (default: 10000)
SHUTDOWN_TIMEOUT_MS=10000

# CACHÉ LRU ACOTADA Y SINCRONIZACIÓN REGIONAL DE DATA MAESTRA
# Máximo de entradas en caché LRU por catálogo maestro (default: 2000)
MASTER_DATA_CACHE_MAX_ITEMS=2000
# TTL en milisegundos de la caché LRU de clientes/vendedores/regiones (default: 300000 = 5 min)
MASTER_DATA_CACHE_TTL_MS=300000
# Tamaño de lote por defecto para upsert regional idempotente de clientes (default: 400)
MASTER_DATA_SYNC_BATCH_SIZE=400

# AUTOMATIZACIÓN DE CIERRE DOMINICAL DE DEGUSTACIONES (SOLO SERVIDOR - NUNCA USAR PREFIJO VITE_)
CRON_SECRET=
APP_TIMEZONE=America/Caracas

# ALMACENAMIENTO PRIVADO DE EVIDENCIAS FOTOGRÁFICAS DE ASISTENCIA (SOLO SERVIDOR - NUNCA USAR PREFIJO VITE_)
ASISTENCIA_STORAGE_BUCKET=asistencia-evidencias
ASISTENCIA_SIGNED_URL_TTL_SECONDS=900

# ENDURECIMIENTO DE PRODUCCION (SOLO SERVIDOR)
# CORS_ALLOWED_ORIGINS: origenes https permitidos para /api separados por coma (vacio = solo mismo origen)
CORS_ALLOWED_ORIGINS=
# TRUST_PROXY_HOPS: numero de proxies delante de Express (Render/Nginx = 1) para limitar tasa por IP real
TRUST_PROXY_HOPS=1
# LOG_LEVEL: debug | info | warn | error
LOG_LEVEL=info

# ==============================================================================
# v1.9.0 — ENLACES DINÁMICOS FIRMADOS (SOLO SERVIDOR - JAMÁS USAR PREFIJO VITE_)
# ==============================================================================
# Secreto HMAC-SHA256 de al menos 32 bytes aleatorios (ej: `openssl rand -hex 32`)
SHIFT_LINK_SECRET=
# Origen HTTPS público para construir las URLs firmadas (`/portal?t=...` y `/logistica/?t=...`)
PUBLIC_APP_ORIGIN=https://trade-marketing-qi6j.onrender.com

# ==============================================================================
# v1.9.0 — ALERTAS AUTOMÁTICAS WHATSAPP CLOUD API DE META (SOLO SERVIDOR)
# NUNCA exponer en variables VITE_* ni commitear valores reales.
# Si se dejan vacías, el despachador degrada limpiamente a estado `pending_config`.
# ==============================================================================
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=nueva_degustacion_trade
WHATSAPP_TEMPLATE_LANG=es
# Teléfono E.164 de respaldo (solo dígitos, ej. 584141234567) si la región no tiene teléfono asignado en public.regiones
WHATSAPP_DEFAULT_RECIPIENT_E164=
# Token secreto para verificación GET /api/webhooks/whatsapp y disparo seguro del despachador
WEBHOOK_VERIFY_TOKEN=

# ==============================================================================
# v1.9.0 — NOTIFICACIONES WEB PUSH VAPID (RFC 8291/8292 · SOLO SERVIDOR)
# Genera el par P-256 una sola vez y NUNCA expongas VAPID_PRIVATE_KEY en VITE_*.
# La llave pública se entrega dinámicamente al navegador mediante GET /api/notifications/web-push/public-key.
# ==============================================================================
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:trade-marketing@codizulca.com

# PORT: Puerto del servidor Express/Vite (por defecto 3000)
PORT=3000

# ==============================================================================
# SUPABASE CLIENTE PÚBLICO — PROYECTO "Trade Marketing"
# SEGURIDAD CRÍTICA:
#   1. Usa la URL raíz del proyecto SIN sufijo "/rest/v1/".
#   2. En VITE_SUPABASE_ANON_KEY usa ÚNICAMENTE la Publishable Key (sb_publishable_...)
#      o la Anon Key pública, gobernadas estrictamente por Row Level Security (RLS).
#   3. PROHIBIDO colocar llaves Secret / Service Role (sb_secret_... o service_role)
#      en variables con prefijo VITE_.
# ==============================================================================
VITE_SUPABASE_URL=https://<tu-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_<tu-clave-publica-ficticia>

# OPCIONAL — CLIENTE DEDICADO PARA DATA MAESTRA (Vendedores / Clientes)
# Si se omiten, masterDataSyncService reutiliza automáticamente VITE_SUPABASE_URL
# y VITE_SUPABASE_ANON_KEY. Útil durante migraciones graduales entre proyectos.
VITE_SUPABASE_MASTER_URL=
VITE_SUPABASE_MASTER_ANON_KEY=

# ==============================================================================
# SUPABASE BACKEND ADMINISTRATIVO (SOLO SERVIDOR - NUNCA USAR PREFIJO VITE_)
# Requerido únicamente en servidor Node/Express para aprovisionar cuentas Auth
# ==============================================================================
SUPABASE_SERVICE_ROLE_KEY=

# CUENTA INICIAL COORDINADORA / ADMIN PARA SCRIPT `npm run auth:provision` (SOLO SERVIDOR, OPCIONAL)
INITIAL_COORDINATOR_EMAIL=
INITIAL_COORDINATOR_PASSWORD=

# EXTRACCIÓN ESTRUCTURADA DE ARCHIVOS PDF EN BACKEND (SOLO SERVIDOR - NUNCA USAR PREFIJO VITE_)
GEMINI_API_KEY=
OPENAI_API_KEY=

# AUTOMATIZACIÓN DE CIERRE DOMINICAL DE DEGUSTACIONES (SOLO SERVIDOR - NUNCA USAR PREFIJO VITE_)
CRON_SECRET=
APP_TIMEZONE=America/Caracas

# ALMACENAMIENTO PRIVADO DE EVIDENCIAS FOTOGRÁFICAS DE ASISTENCIA (SOLO SERVIDOR - NUNCA USAR PREFIJO VITE_)
ASISTENCIA_STORAGE_BUCKET=asistencia-evidencias
ASISTENCIA_SIGNED_URL_TTL_SECONDS=900
